# Copy to .env for local development:  cp .env.example .env
# On Render these are set under the Web Service's Environment tab instead.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where applications land. On an unverified domain, Resend will only deliver
# to the address that owns the Resend account — these must match.
TO_EMAIL=info@drinksoulbreeze.com

# Until drinksoulbreeze.com is verified in Resend, this must stay on the
# resend.dev sender. After verifying the domain:
#   FROM_EMAIL=Soulbreeze Applications <applications@drinksoulbreeze.com>
FROM_EMAIL=Soulbreeze Applications <onboarding@resend.dev>

# Comma-separated list of origins allowed to POST here. The Vite dev server
# runs on :5173, so it must be listed or the browser blocks local submissions.
# On Render, set this to the static site's origin only.
ALLOWED_ORIGIN=http://localhost:5173,https://soulbreeze-client.onrender.com

# PORT is injected by Render — do not set it there. Local default is 3001.
